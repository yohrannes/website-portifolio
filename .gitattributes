# GitHub language detection: ensure YAML files are recognized and counted in repo stats.
**/*.yml linguist-detectable=true
**/*.yaml linguist-detectable=true
**/*.yml linguist-language=YAML
**/*.yaml linguist-language=YAML

# Keep the CI pipeline YAML explicitly recognized even when nested in subdirectories.
pipelines/**/*.yml linguist-language=YAML
pipelines/**/*.yaml linguist-language=YAML
kubernetes/**/*.yml linguist-language=YAML
kubernetes/**/*.yaml linguist-language=YAML
docker-compose/**/*.yml linguist-language=YAML
docker-compose/**/*.yaml linguist-language=YAML

# Enforce LF line endings for all text files
* text=auto eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.tf   text eol=lf

# Explicitly declare binary file types to prevent corruption
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.TTF   binary
*.otf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.gif   binary
*.pyc   binary
